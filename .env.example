# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these per environment (Development / Preview / Production).

# Supabase project URL and the public "anon" / publishable key.
# Local values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this deployment (no trailing slash). Used for invite links
# and, from Phase 2, OAuth redirect URIs. On Vercel previews leave it unset and
# the app falls back to the deployment's own URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection string. Used ONLY at build time on Vercel to run
# migrations (scripts/migrate.mjs). Not read by the running app.
SUPABASE_DB_URL=

# Service-role key. Used by the automated tests to create test users, and by
# the webhook delivery worker (src/server/webhooks/deliver.ts) and nothing else.
# Without it, webhook events are queued but not sent.
SUPABASE_SERVICE_ROLE_KEY=

# The project's JWT secret. The REST API uses it to sign a short-lived database
# token for the member an API key belongs to. Without it, /api/v1 answers 503.
# As sensitive as the service-role key.
SUPABASE_JWT_SECRET=

# Any long random string. Protects the webhook retry route that Vercel Cron
# calls (/api/cron/webhooks). Without it, that route refuses every request.
CRON_SECRET=
